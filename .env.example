# ==========================================================
# SHAJARACHI (shajarachi.uz / shajarachi.vercel.app)
# MUHIT O'ZGARUVCHILARI (ENVIRONMENT VARIABLES)
# ==========================================================

# 1. GOOGLE OAUTH & IDENTITY SERVICES SOZLAMALARI
# Vercel Serverless Backend uchun:
GOOGLE_CLIENT_ID=399388832910-8uikes6k5f91b5b8objvklrrgaji2ins.apps.googleusercontent.com

# Vite Frontend uchun (import.meta.env.VITE_GOOGLE_CLIENT_ID):
VITE_GOOGLE_CLIENT_ID=399388832910-8uikes6k5f91b5b8objvklrrgaji2ins.apps.googleusercontent.com

# Ruxsat etilgan domenlar:
# https://shajarachi.vercel.app
# https://shajarachi.uz
# https://www.shajarachi.uz

# 2. SUPABASE POSTGRESQL BAZA SOZLAMALARI
# Backend (Vercel Serverless Functions) uchun:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Frontend uchun:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. TELEGRAM BOT SOZLAMALARI
TELEGRAM_BOT_USERNAME=shajarachi_bot
VITE_TELEGRAM_BOT_USERNAME=shajarachi_bot

# 4. CLOUDFLARE R2 OBJECT STORAGE (FOTOSURATLAR VA RASMLAR UCHUN)
# Cloudflare Dashboard -> R2 -> Overview / Manage R2 API Tokens orqali olinadi:
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=shajarachi
R2_PUBLIC_URL=https://media.shajarachi.uz
VITE_R2_PUBLIC_URL=https://media.shajarachi.uz